<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="100dp">

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="IP:"
            android:textSize="34sp"
            app:layout_constraintStart_toStartOf="@+id/textIP"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/textIP"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:ems="10"
            android:hint="Enter..."
            android:inputType="text"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView" />

        <Button
            android:id="@+id/btn_on"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#81D4FA"
            android:textColor="@color/black"
            android:text="Turn on PC"
            android:textSize="34sp"
            app:layout_constraintStart_toStartOf="@+id/textPort"
            app:layout_constraintTop_toBottomOf="@+id/textPort" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Port: (default 7776)"
            android:textSize="34sp"
            app:layout_constraintStart_toStartOf="@+id/textIP"
            app:layout_constraintTop_toBottomOf="@+id/textIP" />

        <EditText
            android:id="@+id/textPort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:ems="10"
            android:hint="7776"
            android:inputType="text"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="@+id/textView2"
            app:layout_constraintTop_toBottomOf="@+id/textView2" />

        <Button
            android:id="@+id/btn_fs"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#81D4FA"
            android:textColor="@color/black"
            android:text="Force shutdown"
            android:textSize="34sp"
            app:layout_constraintStart_toStartOf="@+id/btn_on"
            app:layout_constraintTop_toBottomOf="@+id/btn_on" />

        <Button
            android:id="@+id/btn_profile1"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#81D4FA"
            android:textColor="@color/black"
            android:text="1"
            android:textSize="48sp"
            app:layout_constraintStart_toStartOf="@+id/btn_fs"
            app:layout_constraintTop_toBottomOf="@+id/btn_fs" />

        <Button
            android:id="@+id/btn_profile2"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#81D4FA"
            android:textColor="@color/black"
            android:text="2"
            android:textSize="48sp"
            app:layout_constraintEnd_toStartOf="@+id/btn_profile3"
            app:layout_constraintStart_toEndOf="@+id/btn_profile1"
            app:layout_constraintTop_toBottomOf="@+id/btn_fs" />

        <Button
            android:id="@+id/btn_profile3"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="#81D4FA"
            android:textColor="@color/black"
            android:text="3"
            android:textSize="48sp"
            app:layout_constraintEnd_toEndOf="@+id/btn_fs"
            app:layout_constraintTop_toBottomOf="@+id/btn_fs" />

        <ToggleButton
            android:id="@+id/toggle_lan_wan"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#81D4FA"
            android:textColor="@color/black"
            android:checked="false"
            android:textOff="@string/switch_off"
            android:textOn="@string/switch_on"
            app:layout_constraintBottom_toTopOf="@+id/textIP"
            app:layout_constraintEnd_toEndOf="@+id/textIP" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
